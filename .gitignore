#                     订单、卡密）+ .env/docker-compose（DB 与 MySQL root 密码明文）
#   · POINTS_SYSTEM_DESIGN / PHASE_0_1_IMPLEMENTATION_PLAN /
#     ACCOUNT_REGISTRATION_PLAN* → 防刷六道闸、风控参数、**加价倍率（成本×2）**
